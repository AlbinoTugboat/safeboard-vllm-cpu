{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {"metadata": {"()": "safeboard.privacy.MetadataFormatter"}},
  "handlers": {"stdout": {"class": "logging.StreamHandler", "stream": "ext://sys.stdout", "formatter": "metadata"}},
  "root": {"level": "INFO", "handlers": ["stdout"]},
  "loggers": {
    "vllm": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "uvicorn": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "uvicorn.error": {"level": "INFO", "handlers": ["stdout"], "propagate": false},
    "uvicorn.access": {"level": "WARNING", "handlers": ["stdout"], "propagate": false},
    "safeboard.audit": {"level": "INFO", "handlers": ["stdout"], "propagate": false}
  }
}
